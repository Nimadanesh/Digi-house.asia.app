# DigiHouse — root env name list (no secret values)
# Web: copy .env.local.example → .env.local
# API: copy apps/api/.env.example → apps/api/.env

# --- API (P1-01+) ---
PORT=8787
LOG_LEVEL=debug
NODE_ENV=development

# --- Local Docker infra (P1-02) — DEV ONLY passwords; never use in staging/prod ---
# Start: npm run infra:up
DATABASE_URL=postgresql://digihouse:digihouse@localhost:5432/digihouse
REDIS_URL=redis://localhost:6379

# TELEGRAM_BOT_TOKEN=    # P1-04+ secret — never NEXT_PUBLIC_*
# SESSION_SECRET=        # P1-05+ secret (≥32 chars in production)
# JWT_SECRET=            # alias for SESSION_SECRET
# SESSION_TTL_SECONDS=604800
# CORS_ORIGIN=http://localhost:3000
# SETTLEMENT_MODE=mock   # mock | hybrid | onchain

# --- Buy settlement (P5) — API-only; see apps/api/.env.example for full notes ---
# ADMIN_TON_WALLET_ADDRESS=   # receive wallet for native-TON buy payments (real settlement)
# ADMIN_USDT_WALLET_ADDRESS=  # receive wallet for USDT (Jetton) buys
# USDT_JETTON_MASTER_ADDRESS= # USDT master: testnet kQDw5tNMBGsM0ZlLGhA9TSV9iX1nMLrfPZ7HnrQMBxgrAhWe / mainnet EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs
# TON_USD_PRICE_CENTS=200     # USD→TON rate for deriving payable nanoTON
# TON_API_URL=https://testnet.tonapi.io  # mainnet: https://tonapi.io
# TON_API_KEY=                # required on mainnet; recommended on testnet
