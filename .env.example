# FractionalLuxe Telegram Mini App — environment template.
# Copy to `.env.local` for local development. NEVER commit real secrets.
# NOTE: this file documents variable names only — all values below are empty/placeholders.

# --- WalletConnect (EVM wallets: MetaMask, Trust, Coinbase, Rainbow, +100 via QR) ---
# A WalletConnect Project ID is REQUIRED for EVM connections (the app builds and runs
# without it, but EVM picks show a setup message instead of connecting).
# Create a FREE Project ID (no card, ~2 minutes):
#   1. Go to https://cloud.walletconnect.com and sign in (or create an account).
#   2. Dashboard → Create a project → name it e.g. "FractionalLuxe Mini App".
#   3. Copy the Project ID and paste it below.
# TON wallets (Tonkeeper, MyTonWallet, …) do NOT need this — they use TonConnect.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Data source ("mock" default in-memory demo, or "api" for the HTTP backend) ---
NEXT_PUBLIC_DATA_SOURCE=mock
NEXT_PUBLIC_API_BASE_URL=

# --- TON ---
NEXT_PUBLIC_TON_NETWORK=testnet
NEXT_PUBLIC_TONCONNECT_MANIFEST_URL=
NEXT_PUBLIC_TON_RELAY_ADDRESS=

# --- Telegram / misc ---
NEXT_PUBLIC_TG_BOT_USERNAME=
NEXT_PUBLIC_PAYOUT_TICK_MS=60000
NEXT_PUBLIC_DEV_TOKEN=
