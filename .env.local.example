# DigiHouse — local environment (copy to .env.local, never commit the real one)
# All client-exposed vars MUST use the NEXT_PUBLIC_ prefix.

# Active TON network. MVP = testnet. Flip to "mainnet" post-MVP.
NEXT_PUBLIC_TON_NETWORK=testnet

# TonConnect manifest URL override.
# If empty, resolved at runtime to ${origin}/seo/tonconnect-manifest.json (recommended).
# In dev you need an HTTPS origin for TonConnect (Telegram Mini Apps require HTTPS):
#   tunnel via `bunx mkcert` + next dev --experimental-https, or ngrok/cloudflared.
# NEXT_PUBLIC_TONCONNECT_MANIFEST_URL=

# Testnet relay / property-owner address for the 0.01 TON buy stub.
# Empty = the buy flow falls back to the seeded property's ownerWalletAddress.
NEXT_PUBLIC_TON_RELAY_ADDRESS=

# Mock weekly-payout scheduler cadence (ms). Short so a judge sees a payout live during the demo.
# Real Friday-UTC distribution is a post-MVP on-chain job (DATA_MODELS §6).
NEXT_PUBLIC_PAYOUT_TICK_MS=60000