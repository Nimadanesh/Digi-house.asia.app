# DigiHouse — local environment (copy to .env.local, never commit the real one)
# All client-exposed vars MUST use the NEXT_PUBLIC_ prefix.

# Data source: "mock" (default, in-memory) or "api" (HTTP behind getRepo).
# When api, NEXT_PUBLIC_API_BASE_URL is required.
NEXT_PUBLIC_DATA_SOURCE=mock
# NEXT_PUBLIC_DATA_SOURCE=api
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
# Staging: NEXT_PUBLIC_API_BASE_URL=https://digihouse-api-staging.fly.dev

# Active TON network. MVP = testnet. Flip to "mainnet" post-MVP only.
NEXT_PUBLIC_TON_NETWORK=testnet

# TonConnect manifest URL override (absolute HTTPS after deploy).
# If empty, runtime uses ${origin}/seo/tonconnect-manifest.json
# NEXT_PUBLIC_TONCONNECT_MANIFEST_URL=https://YOUR_PROJECT.vercel.app/seo/tonconnect-manifest.json

# Testnet relay / property-owner address for the 0.01 TON buy stub.
# Empty = fall back to the seeded property ownerWalletAddress.
NEXT_PUBLIC_TON_RELAY_ADDRESS=

# Mock weekly-payout scheduler cadence (ms). Short so a judge sees a payout live during the demo.
# Real Sunday-UTC distribution is a post-MVP on-chain job (DATA_MODELS §6).
NEXT_PUBLIC_PAYOUT_TICK_MS=60000

# Optional: Telegram bot username (no @) for share deep links after buy success.
# NEXT_PUBLIC_TG_BOT_USERNAME=DigiHouseBot

# Dev bypass: skip Telegram initData auth by setting a known JWT here.
# Useful when developing against a local API without Telegram WebApp.
# NEXT_PUBLIC_DEV_TOKEN=eyJhbGciOiJIUzI1NiJ9...
