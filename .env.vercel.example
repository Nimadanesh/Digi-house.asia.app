# DigiHouse — Vercel (frontend) environment.
# Paste into Vercel project → Settings → Environment Variables (Production + Preview).
# NEVER commit real .env files; this is a template only.

# --- Data source ---
# mock = in-memory (no backend needed, data resets per deployment instance).
# api = real backend via NEXT_PUBLIC_API_BASE_URL. Backend hosting is still undecided;
#       for a first Vercel deploy use "mock", then flip to "api" once the API is public.
NEXT_PUBLIC_DATA_SOURCE=mock
# Required when NEXT_PUBLIC_DATA_SOURCE=api. MUST be a public HTTPS URL (no localhost).
# NEXT_PUBLIC_API_BASE_URL=https://your-api.example.com

# --- TON network (MVP = testnet) ---
NEXT_PUBLIC_TON_NETWORK=testnet

# --- TonConnect manifest ---
# Optional. If empty, the app uses ${origin}/seo/tonconnect-manifest.json at runtime.
# NOTE: that static file still contains YOUR_DEPLOYMENT.vercel.app placeholders — update
# public/seo/tonconnect-manifest.json with the real domain after the first deploy, or set
# this to a manifest hosted with real URLs.
# NEXT_PUBLIC_TONCONNECT_MANIFEST_URL=https://your-project.vercel.app/seo/tonconnect-manifest.json

# --- Buy flow (testnet) ---
# Optional: overrides the per-property ownerWalletAddress for the 0.01 TON buy stub.
NEXT_PUBLIC_TON_RELAY_ADDRESS=

# --- Misc / optional ---
# Mock weekly-payout scheduler cadence (ms). Default 60000 (1 min) for demos.
NEXT_PUBLIC_PAYOUT_TICK_MS=60000
# Telegram bot username (no @) for share deep links. Leave empty if bot is not configured yet.
# NEXT_PUBLIC_TG_BOT_USERNAME=DigiHouseBot
# Dev-only JWT bypass for Telegram initData auth. Never set in Production.
# NEXT_PUBLIC_DEV_TOKEN=
