import { Hono } from "hono";
import { requireSession } from "../auth/require-session.js";
import type { SessionConfig } from "../auth/session.js";
import type { UserStore } from "../auth/user-store.js";
import type { EarningsStore } from "../earnings/earnings-store.js";
import { buildEarningsSummary } from "../earnings/map-earnings.js";
import type { ShareLockStore } from "../yield/lock-store.js";
import type { YieldStore } from "../yield/yield-store.js";
import { installmentUsd } from "../yield/yield-math.js";

export type YieldSummaryPublic = {
  activeLocks: number;
  lockedShares: number;
  principalUsd: number;
  /** Accrued since the last payout across active locks (display only). */
  accruedUnpaidUsd: number;
  /** Sum of one installment per active lock at its chosen period. */
  projectedInstallmentUsd: number;
  projectedMonthlyUsd: number;
  projectedWeeklyUsd: number;
  payments: Array<{
    id: string;
    propertyId: string;
    periodStart: string;
    periodEnd: string;
    amountUsd: number;
    kind: "scheduled" | "final";
    status: "paid" | "pending";
    createdAt: string;
  }>;
};

export type EarningsRouteDeps = {
  session: SessionConfig;
  users: UserStore;
  earnings: EarningsStore;
  /** Present → the response gains a `yield` block (v2, PRODUCT-PLAN PB-06). */
  yieldDeps?: {
    locks: ShareLockStore;
    yields: YieldStore;
  } | null;
};

export async function buildYieldSummary(
  deps: { locks: ShareLockStore; yields: YieldStore },
  userId: string,
): Promise<YieldSummaryPublic> {
  const locks = await deps.locks.listByUser(userId);
  const active = locks.filter(
    (l) => l.status === "locked" || l.status === "unlock_requested",
  );

  let lockedShares = 0;
  let principalUsd = 0;
  let accruedUnpaidUsd = 0;
  let projectedInstallmentUsd = 0;
  let projectedMonthlyUsd = 0;
  let projectedWeeklyUsd = 0;
  for (const lock of active) {
    lockedShares += lock.shares;
    principalUsd += lock.principalUsd;
    accruedUnpaidUsd += await deps.yields.sumAccruedAfter(
      lock.id,
      lock.paidThroughDay,
    );
    projectedInstallmentUsd += installmentUsd(
      lock.principalUsd,
      lock.monthlyRate,
      lock.payoutPeriod,
    );
    projectedMonthlyUsd += installmentUsd(lock.principalUsd, lock.monthlyRate, "monthly");
    projectedWeeklyUsd += installmentUsd(lock.principalUsd, lock.monthlyRate, "weekly");
  }

  const payments = await deps.yields.listPaymentsByUser(userId, { limit: 20 });

  return {
    activeLocks: active.length,
    lockedShares,
    principalUsd,
    accruedUnpaidUsd,
    projectedInstallmentUsd,
    projectedMonthlyUsd,
    projectedWeeklyUsd,
    payments: payments.map((p) => ({
      id: p.id,
      propertyId: p.propertyId,
      periodStart: p.periodStart,
      periodEnd: p.periodEnd,
      amountUsd: p.amountUsd,
      kind: p.kind,
      status: p.status,
      createdAt: p.createdAt.toISOString(),
    })),
  };
}

export function createEarningsRoutes(deps: EarningsRouteDeps) {
  const app = new Hono();

  app.get(
    "/v1/earnings",
    requireSession({ session: deps.session, users: deps.users }),
    async (c) => {
      const userId = c.get("userId");
      const rows = await deps.earnings.listEntriesByUserId(userId);
      const summary = buildEarningsSummary(rows);
      if (!deps.yieldDeps) {
        return c.json(summary);
      }
      return c.json({
        ...summary,
        yield: await buildYieldSummary(deps.yieldDeps, userId),
      });
    },
  );

  return app;
}
