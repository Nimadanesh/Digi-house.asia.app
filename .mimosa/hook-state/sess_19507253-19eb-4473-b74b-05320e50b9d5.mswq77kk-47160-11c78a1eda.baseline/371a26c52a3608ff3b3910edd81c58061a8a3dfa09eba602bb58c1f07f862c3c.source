import type { SEED_PROPERTIES } from "./properties-data.js";

/**
 * Monthly yield rate for seed rows: newer builds earn toward 7.5%, older toward 4.5%
 * (PRODUCT-PLAN §0.4 — quality-driven rate). Deterministic from yearBuilt.
 */
function seedYieldRate(yearBuilt: number): string {
  const minYear = 1975;
  const maxYear = 2024;
  const t = Math.min(1, Math.max(0, (yearBuilt - minYear) / (maxYear - minYear)));
  return (4.5 + t * 3).toFixed(2);
}

export function toPropertyInsert(s: (typeof SEED_PROPERTIES)[number]) {
  const now = new Date();
  return {
    id: s.id,
    title: s.title,
    location: s.location,
    description: s.description,
    images: s.images,
    totalShares: s.totalShares,
    sharePriceUsd: s.sharePriceUsd,
    status: s.status,
    ownerWalletAddress: s.ownerWalletAddress,
    annualRentUsd: s.annualRentUsd,
    totalValueUsd: s.totalValueUsd,
    sharesSold: s.sharesSold,
    monthlyYieldRate: seedYieldRate(s.meta.yearBuilt),
    jettonDecimals: 9,
    salePaused: false,
    distributionPaused: false,
    tokenizationStatus: "pending" as const,
    meta: s.meta,
    rentalHistory: s.rentalHistory,
    onchainMaster: null as string | null,
    distributionAddress: null as string | null,
    createdAt: new Date(s.createdAt),
    updatedAt: now,
  };
}
