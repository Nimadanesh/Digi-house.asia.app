import { and, desc, eq, inArray, sql } from "drizzle-orm";
import type { Db } from "../db/client.js";
import { orders } from "../db/schema/orders.js";
import type {
  OrderRecord,
  OrderSide,
  OrderStatus,
} from "./map-order.js";

export type { OrderRecord, OrderSide, OrderStatus };

export type OrderStore = {
  /** Order-book input: only tradable 'open' orders (queued are parked, §0.3). */
  listOpenByPropertyId(propertyId: string): Promise<OrderRecord[]>;
  /** User's active orders: open + queued. */
  listOpenByUserId(userId: string): Promise<OrderRecord[]>;
  getById(id: string): Promise<OrderRecord | null>;
  insert(input: {
    id: string;
    userId: string;
    propertyId: string;
    makerAddress: string;
    side: OrderSide;
    priceUsd: number;
    quantity: number;
    /** 'queued' for custom sells on a funding property; default 'open'. */
    status?: OrderStatus;
    /** Buy orders: escrow held aside from the investing balance. */
    escrowedUsd?: number;
    isHouseAccount?: boolean;
  }): Promise<OrderRecord>;
  /**
   * Race-safe fill application (PD-02): bumps filled_quantity by exactly `qty`,
   * sets status 'filled' when complete, and (buy orders) reduces the held escrow
   * by `escrowRelease`. Returns the updated row, or null when the guard tripped.
   */
  applyFill(
    id: string,
    qty: number,
    opts?: { escrowRelease?: number },
  ): Promise<OrderRecord | null>;
  /** Refund-set the remaining escrow to zero (after cancel/terminal). Returns released cents. */
  releaseEscrow(id: string): Promise<number>;
  cancelIfOpen(
    id: string,
    userId: string,
  ): Promise<
    | { ok: true; record: OrderRecord }
    | { ok: false; reason: "not_found" | "forbidden" | "not_open" }
  >;
  /** Unfilled sell shares held by active (open/queued) orders — the sell escrow. */
  sumActiveSellShares(userId: string, propertyId: string): Promise<number>;
  /**
   * Order Activation Trigger (§0.3): flip every queued order of a property to open
   * in one statement. Idempotent — safe to call on every sellout; supply returning
   * via instant sell can never re-queue an activated order.
   */
  activateQueuedForProperty(propertyId: string): Promise<OrderRecord[]>;
};

function mapRow(r: {
  id: string;
  userId: string;
  propertyId: string;
  makerAddress: string;
  side: string;
  priceUsd: number | bigint;
  quantity: number;
  filledQuantity: number;
  status: string;
  escrowedUsd: number | bigint | null;
  isHouseAccount: boolean | null;
  createdAt: Date;
  updatedAt: Date;
}): OrderRecord {
  return {
    id: r.id,
    userId: r.userId,
    propertyId: r.propertyId,
    makerAddress: r.makerAddress,
    side: r.side === "sell" ? "sell" : "buy",
    priceUsd: Number(r.priceUsd),
    quantity: r.quantity,
    filledQuantity: r.filledQuantity,
    status: normalizeStatus(r.status),
    escrowedUsd: Number(r.escrowedUsd ?? 0),
    isHouseAccount: r.isHouseAccount ?? false,
    createdAt: r.createdAt,
    updatedAt: r.updatedAt,
  };
}

function normalizeStatus(s: string): OrderStatus {
  if (
    s === "open" ||
    s === "queued" ||
    s === "filled" ||
    s === "cancelled" ||
    s === "rejected"
  ) {
    return s;
  }
  return "cancelled";
}

export function createDbOrderStore(db: Db): OrderStore {
  return {
    async listOpenByPropertyId(propertyId) {
      const rows = await db
        .select()
        .from(orders)
        .where(
          and(eq(orders.propertyId, propertyId), eq(orders.status, "open")),
        );
      return rows.map(mapRow);
    },

    async listOpenByUserId(userId) {
      const rows = await db
        .select()
        .from(orders)
        .where(
          and(
            eq(orders.userId, userId),
            inArray(orders.status, ["open", "queued"]),
          ),
        )
        .orderBy(desc(orders.createdAt));
      return rows.map(mapRow);
    },

    async getById(id) {
      const rows = await db
        .select()
        .from(orders)
        .where(eq(orders.id, id))
        .limit(1);
      const row = rows[0];
      return row ? mapRow(row) : null;
    },

    async insert(input) {
      const now = new Date();
      const rows = await db
        .insert(orders)
        .values({
          id: input.id,
          userId: input.userId,
          propertyId: input.propertyId,
          makerAddress: input.makerAddress,
          side: input.side,
          priceUsd: input.priceUsd,
          quantity: input.quantity,
          filledQuantity: 0,
          status: input.status ?? "open",
          escrowedUsd: input.escrowedUsd ?? 0,
          isHouseAccount: input.isHouseAccount ?? false,
          createdAt: now,
          updatedAt: now,
        })
        .returning();
      const row = rows[0];
      if (!row) throw new Error("insert order returned no row");
      return mapRow(row);
    },

    async applyFill(id, qty, opts = {}) {
      if (qty <= 0) return null;
      const release = opts.escrowRelease ?? 0;
      const rows = await db
        .update(orders)
        .set({
          filledQuantity: sql`${orders.filledQuantity} + ${qty}`,
          escrowedUsd: sql`GREATEST(${orders.escrowedUsd} - ${release}, 0)`,
          updatedAt: new Date(),
        })
        .where(
          and(
            eq(orders.id, id),
            sql`${orders.filledQuantity} + ${qty} <= ${orders.quantity}`,
            sql`${orders.status} = 'open'`,
          ),
        )
        .returning();
      const row = rows[0];
      if (!row) return null;
      const filled = mapRow(row);
      if (filled.filledQuantity >= filled.quantity && filled.status === "open") {
        const done = await db
          .update(orders)
          .set({ status: "filled", updatedAt: new Date() })
          .where(and(eq(orders.id, id), eq(orders.status, "open")))
          .returning();
        return done[0] ? mapRow(done[0]) : filled;
      }
      return filled;
    },

    async releaseEscrow(id) {
      // read-then-guarded-update: the WHERE escrowed_usd = <read> makes a concurrent
      // change lose the race instead of double-releasing.
      const current = await db
        .select({ escrowedUsd: orders.escrowedUsd })
        .from(orders)
        .where(eq(orders.id, id))
        .limit(1);
      const held = Number(current[0]?.escrowedUsd ?? 0);
      if (held <= 0) return 0;
      const rows = await db
        .update(orders)
        .set({ escrowedUsd: 0, updatedAt: new Date() })
        .where(and(eq(orders.id, id), eq(orders.escrowedUsd, held)))
        .returning({ id: orders.id });
      return rows.length > 0 ? held : 0;
    },

    async cancelIfOpen(id, userId) {
      const now = new Date();
      const updated = await db
        .update(orders)
        .set({ status: "cancelled", updatedAt: now })
        .where(
          and(
            eq(orders.id, id),
            eq(orders.userId, userId),
            inArray(orders.status, ["open", "queued"]),
          ),
        )
        .returning();
      if (updated.length > 0) {
        return { ok: true, record: mapRow(updated[0]!) };
      }
      const existing = await this.getById(id);
      if (!existing) return { ok: false, reason: "not_found" };
      if (existing.userId !== userId) {
        return { ok: false, reason: "forbidden" };
      }
      return { ok: false, reason: "not_open" };
    },

    async sumActiveSellShares(userId, propertyId) {
      const rows = await db
        .select({
          total: sql<string>`coalesce(sum(${orders.quantity} - ${orders.filledQuantity}), 0)`,
        })
        .from(orders)
        .where(
          and(
            eq(orders.userId, userId),
            eq(orders.propertyId, propertyId),
            eq(orders.side, "sell"),
            inArray(orders.status, ["open", "queued"]),
          ),
        );
      return Number(rows[0]?.total ?? 0);
    },

    async activateQueuedForProperty(propertyId) {
      const now = new Date();
      const rows = await db
        .update(orders)
        .set({ status: "open", updatedAt: now })
        .where(
          and(eq(orders.propertyId, propertyId), eq(orders.status, "queued")),
        )
        .returning();
      return rows.map(mapRow);
    },
  };
}

/** In-memory store for unit tests (no Postgres). */
export function createMemoryOrderStore(
  seed: Array<Partial<OrderRecord> & Pick<OrderRecord, "id" | "userId" | "propertyId" | "side" | "priceUsd" | "quantity">> = [],
): OrderStore & { _rows: OrderRecord[] } {
  const now = new Date();
  const rows: OrderRecord[] = seed.map((r) => ({
    makerAddress: "EQ",
    filledQuantity: 0,
    status: "open",
    escrowedUsd: 0,
    isHouseAccount: false,
    createdAt: now,
    updatedAt: now,
    ...r,
  } as OrderRecord));

  return {
    _rows: rows,

    async listOpenByPropertyId(propertyId) {
      return rows
        .filter((r) => r.propertyId === propertyId && r.status === "open")
        .map((r) => ({ ...r }));
    },

    async listOpenByUserId(userId) {
      return rows
        .filter(
          (r) =>
            r.userId === userId && (r.status === "open" || r.status === "queued"),
        )
        .map((r) => ({ ...r }))
        .sort((a, b) => b.createdAt.getTime() - a.createdAt.getTime());
    },

    async getById(id) {
      const row = rows.find((r) => r.id === id);
      return row ? { ...row } : null;
    },

    async insert(input) {
      const now = new Date();
      const record: OrderRecord = {
        id: input.id,
        userId: input.userId,
        propertyId: input.propertyId,
        makerAddress: input.makerAddress,
        side: input.side,
        priceUsd: input.priceUsd,
        quantity: input.quantity,
        filledQuantity: 0,
        status: input.status ?? "open",
        escrowedUsd: input.escrowedUsd ?? 0,
        isHouseAccount: input.isHouseAccount ?? false,
        createdAt: now,
        updatedAt: now,
      };
      rows.push(record);
      return { ...record };
    },

    async applyFill(id, qty, opts = {}) {
      if (qty <= 0) return null;
      const row = rows.find((r) => r.id === id);
      if (!row || row.status !== "open") return null;
      if (row.filledQuantity + qty > row.quantity) return null;
      row.filledQuantity += qty;
      row.escrowedUsd = Math.max(0, row.escrowedUsd - (opts.escrowRelease ?? 0));
      row.updatedAt = new Date();
      if (row.filledQuantity >= row.quantity) row.status = "filled";
      return { ...row };
    },

    async releaseEscrow(id) {
      const row = rows.find((r) => r.id === id);
      if (!row || row.escrowedUsd <= 0) return 0;
      const held = row.escrowedUsd;
      row.escrowedUsd = 0;
      row.updatedAt = new Date();
      return held;
    },

    async cancelIfOpen(id, userId) {
      const idx = rows.findIndex((r) => r.id === id);
      if (idx < 0) return { ok: false, reason: "not_found" };
      const existing = rows[idx]!;
      if (existing.userId !== userId) {
        return { ok: false, reason: "forbidden" };
      }
      if (existing.status !== "open" && existing.status !== "queued") {
        return { ok: false, reason: "not_open" };
      }
      const updated: OrderRecord = {
        ...existing,
        status: "cancelled" as OrderStatus,
        updatedAt: new Date(),
      };
      rows[idx] = updated;
      return { ok: true, record: { ...updated } };
    },

    async sumActiveSellShares(userId, propertyId) {
      return rows
        .filter(
          (r) =>
            r.userId === userId &&
            r.propertyId === propertyId &&
            r.side === "sell" &&
            (r.status === "open" || r.status === "queued"),
        )
        .reduce((s, r) => s + (r.quantity - r.filledQuantity), 0);
    },

    async activateQueuedForProperty(propertyId) {
      const activated: OrderRecord[] = [];
      for (const r of rows) {
        if (r.propertyId === propertyId && r.status === "queued") {
          r.status = "open";
          r.updatedAt = new Date();
          activated.push({ ...r });
        }
      }
      return activated;
    },
  };
}
