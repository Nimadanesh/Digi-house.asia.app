// File responsibility: deterministic property listings (every funding/funded/resale state).
import type { Listing, RentalPayment } from "@/types/property";

function history(prefix: string, dates: string[]): RentalPayment[] {
  return dates.map((paidAt, i) => ({
    id: `${prefix}-rent-${i + 1}`,
    paidAt,
    status: "paid" as const,
  }));
}

