export type OrderSide = "buy" | "sell";
/**
 * "queued": custom-price sell parked while the property is in its primary offering
 * (PRODUCT-PLAN §0.3) — activated atomically when supply sells out.
 */
export type OrderStatus = "open" | "queued" | "filled" | "cancelled" | "rejected";

export type OrderRecord = {
  id: string;
  userId: string;
  propertyId: string;
  makerAddress: string;
  side: OrderSide;
  priceUsd: number;
  quantity: number;
  filledQuantity: number;
  status: OrderStatus;
  /** Buy orders: escrow still held (notional + fee portion for the unfilled part). */
  escrowedUsd: number;
  isHouseAccount: boolean;
  createdAt: Date;
  updatedAt: Date;
};

/** Public Order JSON — matches Mini App `Order` / OpenAPI. */
export type OrderPublic = {
  id: string;
  propertyId: string;
  makerAddress: string;
  side: OrderSide;
  priceUsd: number;
  quantity: number;
  filledQuantity: number;
  status: OrderStatus;
  escrowedUsd?: number;
  isHouseAccount?: boolean;
  createdAt: string;
};

export function mapOrderRecord(row: OrderRecord): OrderPublic {
  return {
    id: row.id,
    propertyId: row.propertyId,
    makerAddress: row.makerAddress,
    side: row.side,
    priceUsd: Number(row.priceUsd),
    quantity: row.quantity,
    filledQuantity: row.filledQuantity,
    status: row.status,
    escrowedUsd: row.escrowedUsd,
    isHouseAccount: row.isHouseAccount,
    createdAt: row.createdAt.toISOString(),
  };
}
