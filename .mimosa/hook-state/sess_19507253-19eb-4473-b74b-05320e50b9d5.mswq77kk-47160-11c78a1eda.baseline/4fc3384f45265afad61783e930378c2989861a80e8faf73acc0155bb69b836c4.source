/** MVP display FX: 1 TON = $2.00 → nanoTON per USD cent. Match Mini App mock. */
export const NANO_PER_USD_MINOR = 5_000_000;

/** tonAmount = amountUsd * NANO_PER_USD_MINOR (integer nanoTON). */
export function tonFromUsdCents(amountUsdCents: number): number {
  return amountUsdCents * NANO_PER_USD_MINOR;
}
