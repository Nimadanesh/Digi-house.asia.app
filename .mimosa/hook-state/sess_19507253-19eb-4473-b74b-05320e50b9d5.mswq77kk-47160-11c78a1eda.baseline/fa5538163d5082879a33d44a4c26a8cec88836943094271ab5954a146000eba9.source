export type OrderSide = "buy" | "sell";
/** "queued": custom sell parked while the primary offering is open (§0.3). */
export type OrderStatus = "open" | "queued" | "filled" | "cancelled" | "rejected";

export interface Order {
  id: string;
  propertyId: string;
  makerAddress: string;
  side: OrderSide;
  priceUsd: number;   // minor units per share
  quantity: number;
  filledQuantity: number;
  status: OrderStatus;
  createdAt: string;
}

export interface OrderBookLevel {
  priceUsd: number;
  quantity: number;
  cumulative: number;
}

export interface OrderBookState {
  propertyId: string;
  bids: OrderBookLevel[];   // DESC by price
  asks: OrderBookLevel[];   // ASC by price
  bestBidUsd?: number;
  bestAskUsd?: number;
  lastTradeUsd?: number;
}

/** Executed fill on the secondary market (PD-04). Money: integer cents. */
export interface Trade {
  id: string;
  propertyId: string;
  priceUsd: number;
  quantity: number;
  buyFeeUsd: number;
  sellFeeUsd: number;
  createdAt: string;
}