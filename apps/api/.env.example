# DigiHouse API — local env (copy to .env; never commit secrets)
NODE_ENV=development
PORT=8787
LOG_LEVEL=debug
# SETTLEMENT_MODE=mock

# Local Docker infra (P1-02) — DEV ONLY passwords
# npm run infra:up  (from repo root)
DATABASE_URL=postgresql://digihouse:digihouse@localhost:5432/digihouse
REDIS_URL=redis://localhost:6379

# Telegram bot token — SECRET (P1-04+). Never NEXT_PUBLIC_*.
# From BotFather; used only server-side for initData HMAC.
TELEGRAM_BOT_TOKEN=

# Session JWT (P1-05) — SECRET. Prefer SESSION_SECRET; JWT_SECRET is an alias.
# Production: ≥32 random chars. Dev default exists only when NODE_ENV≠production.
SESSION_SECRET=dev-only-session-secret-min-32-chars!!
# JWT_SECRET=
SESSION_TTL_SECONDS=604800
CORS_ORIGIN=http://localhost:3000
# Staging: CORS_ORIGIN=https://<mini-app>.vercel.app

# Hybrid buy prepare (P1-12) — optional TonConnect stub
# TON_RELAY_ADDRESS=
BUY_STUB_NANOTON=10000000
BUY_INTENT_TTL_SECONDS=900

# Payout worker (P1-13) — hybrid pending→paid; no on-chain transfer
# Demo cadence PAYOUT_TICK_MS ≠ production Friday (ADR-003)
# REDIS_URL=redis://localhost:6379
PAYOUT_TICK_MS=60000
PAYOUT_WORKER_ENABLED=false
# ALLOW_MANUAL_PAYOUT_TICK=false
# PAYOUT_TICK_SECRET=

