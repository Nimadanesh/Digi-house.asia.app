# DigiHouse API — local env (copy to .env; never commit secrets)
NODE_ENV=development
PORT=8787
LOG_LEVEL=debug
# SETTLEMENT_MODE=mock

# Local Docker infra (P1-02) — DEV ONLY passwords
# npm run infra:up  (from repo root)
DATABASE_URL=postgresql://digihouse:digihouse@localhost:5432/digihouse
REDIS_URL=redis://localhost:6379

# Telegram bot token — SECRET (P1-04+). Never NEXT_PUBLIC_*.
# From BotFather; used only server-side for initData HMAC.
TELEGRAM_BOT_TOKEN=

# Session JWT (P1-05) — SECRET. Prefer SESSION_SECRET; JWT_SECRET is an alias.
# Production: ≥32 random chars. Dev default exists only when NODE_ENV≠production.
SESSION_SECRET=dev-only-session-secret-min-32-chars!!
# JWT_SECRET=
SESSION_TTL_SECONDS=604800
CORS_ORIGIN=http://localhost:3000
# Staging: CORS_ORIGIN=https://<mini-app>.vercel.app

# Buy settlement (P5) — on-chain verification + admin receive wallets
# ADMIN_TON_WALLET_ADDRESS is the receive destination for native-TON buy payments (fallback order:
# admin > TON_RELAY_ADDRESS > listing owner). REQUIRED for real (non-stub) settlement on-chain.
# ADMIN_USDT_WALLET_ADDRESS + USDT_JETTON_MASTER_ADDRESS enable the USDT (Jetton) rail (ADR-005).
ADMIN_TON_WALLET_ADDRESS=
ADMIN_USDT_WALLET_ADDRESS=
# USDT jetton master contract — testnet (USDTTT): kQDw5tNMBGsM0ZlLGhA9TSV9iX1nMLrfPZ7HnrQMBxgrAhWe
# mainnet (USDT): EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs
# USE ONLY ONE, matching TON_API_URL's network — a testnet master on mainnet will reject every settle.
USDT_JETTON_MASTER_ADDRESS=
# USD→TON rate used by /v1/buys/prepare to derive the payable nanoTON amount (cents per TON).
TON_USD_PRICE_CENTS=200
# TON_RELAY_ADDRESS=
# NanoTON fallback amount only when TON_USD_PRICE_CENTS is unset (0.01 TON).
BUY_STUB_NANOTON=10000000
BUY_INTENT_TTL_SECONDS=900

# TonAPI configuration — shared by on-chain buy verification (POST /v1/buys/verify-and-settle) + indexer (P3-01/02/03)
# Testnet: https://testnet.tonapi.io   Mainnet: https://tonapi.io
# TON_API_KEY=  # required on mainnet; recommended on testnet (higher rate limits)
TON_API_URL=https://testnet.tonapi.io
# TON_API_KEY=
INDEXER_ENABLED=false
INDEXER_POLL_MS=10000

# Payout worker (P1-13) — hybrid pending→paid; no on-chain transfer
# Demo cadence PAYOUT_TICK_MS ≠ production Friday (ADR-003)
# REDIS_URL=redis://localhost:6379
PAYOUT_TICK_MS=60000
PAYOUT_WORKER_ENABLED=false
# ALLOW_MANUAL_PAYOUT_TICK=false
# PAYOUT_TICK_SECRET=

