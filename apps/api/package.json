{
  "name": "@digihouse/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DigiHouse HTTP API (Hono) — Phase 1+",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed/seed-properties.ts",
    "db:studio": "drizzle-kit studio",
    "worker": "tsx src/worker.ts"
  },
  "dependencies": {
    "@digihouse/shared": "*",
    "@hono/node-server": "^1.19.0",
    "bullmq": "^5.81.2",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.9.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.4",
    "pino": "^9.9.0",
    "postgres": "^3.4.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "drizzle-kit": "^0.31.0",
    "pino-pretty": "^13.1.1",
    "tsx": "^4.20.0",
    "typescript": "~5.6",
    "vitest": "^4.1.10"
  }
}
