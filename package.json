{
  "name": "digihouse",
  "version": "0.1.0",
  "private": true,
  "description": "DigiHouse — Telegram Mini App for fractional property on TON (buy/sell/earn weekly rental yield)",
  "author": "JCodesMore",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nimadanesh/miniApp.git"
  },
  "homepage": "https://github.com/Nimadanesh/miniApp",
  "bugs": {
    "url": "https://github.com/Nimadanesh/miniApp/issues"
  },
  "keywords": [
    "digihouse",
    "telegram-mini-app",
    "ton",
    "the-open-network",
    "real-estate",
    "fractional-ownership",
    "rental-yield",
    "nextjs",
    "react",
    "tailwindcss",
    "shadcn-ui",
    "tonconnect"
  ],
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:api": "npm run dev -w @digihouse/api",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "npm run typecheck -w @digihouse/api",
    "typecheck:shared": "npm run typecheck -w @digihouse/shared",
    "check": "npm run lint && npm run typecheck && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "infra:up": "docker compose -f docker-compose.infra.yml up -d",
    "infra:down": "docker compose -f docker-compose.infra.yml down",
    "infra:down:v": "docker compose -f docker-compose.infra.yml down -v",
    "infra:ps": "docker compose -f docker-compose.infra.yml ps",
    "infra:logs": "docker compose -f docker-compose.infra.yml logs -f",
    "db:generate": "npm run db:generate -w @digihouse/api",
    "db:migrate": "npm run db:migrate -w @digihouse/api",
    "db:seed": "npm run db:seed -w @digihouse/api",
    "test:api": "npm run test -w @digihouse/api",
    "phase1:verify": "npm run test:api && npm run check",
    "phase1:smoke-api": "bash scripts/smoke-marketplace.sh",
    "phase1:smoke-rate-limit": "echo 'Run: for i in $(seq 1 11); do curl -s -o /dev/null -w \"%{http_code}\n\" -X POST http://localhost:8787/v1/auth/telegram -H \"content-type: application/json\" -d \"{\\\"initData\\\":\\\"test\\\"}\"; done | sort | uniq -c'",
    "phase1:check-all": "npm run phase1:verify && npm run phase1:smoke-api"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@tanstack/react-query": "^5.101.4",
    "@telegram-apps/sdk-react": "^3.3.9",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.3.0",
    "@tonconnect/ui-react": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.6.0",
    "next": "16.2.1",
    "next-intl": "^4.13.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "ton": "^13.9.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "~5.6",
    "vitest": "^4.1.10"
  }
}
